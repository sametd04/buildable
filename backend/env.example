# LLM Configuration
# Choose one: "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Model (adjust based on provider)
# For OpenAI: gpt-4o-mini, gpt-4o, gpt-4-turbo, etc.
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-ada-002

# FLUX API Configuration (Black Forest Labs)
BFL_API_KEY=your_bfl_api_key_here
# Available models: flux-pro-1.1, flux-pro, flux-dev, flux-schnell
FLUX_MODEL=flux-pro-1.1

# Langfuse Configuration (for tracing and observability)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
# Optional: Use self-hosted Langfuse instance or different region
# LANGFUSE_BASE_URL=https://cloud.langfuse.com  # Default: https://cloud.langfuse.com
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com  # US region
# Optional: Specify project name (defaults to default project)
# LANGFUSE_PROJECT=buildable

# Application Configuration
DEBUG=False
API_TITLE=Buildable API
API_VERSION=0.1.0

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=buildable_db

# Data Configuration (for seeding)
INVENTORY_PATH=data/inventory.json

