# LLM Configuration
# Choose one: "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Model (adjust based on provider)
# For OpenAI: gpt-4o-mini, gpt-4o, gpt-4-turbo, etc.
LLM_MODEL=gpt-4o-mini

# FLUX API Configuration (Black Forest Labs)
BFL_API_KEY=your_bfl_api_key_here
# Available models: flux-pro-1.1, flux-pro, flux-dev, flux-schnell
FLUX_MODEL=flux-pro-1.1

# Application Configuration
DEBUG=False
API_TITLE=Buildable API
API_VERSION=0.1.0

# MongoDB Configuration
MONGO_URI=mongodb+srv://admin:CfY4mVC0JIAU5WIv@buildable-cluster.eikuipu.mongodb.net/?appName=buildable-cluster
MONGO_DB_NAME=buildable_db

# Data Configuration (for seeding)
INVENTORY_PATH=data/inventory.json

